<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CalculatorApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/calculator_operator_key</item>
        <item name="colorOnPrimary">@color/calculator_text_primary</item>
        <item name="android:colorAccent">@color/calculator_operator_key</item>
        <item name="android:statusBarColor">@color/calculator_background</item>
        <item name="android:navigationBarColor">@color/calculator_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/calculator_background</item>
        <item name="materialButtonStyle">@style/CalculatorNumberButton</item>
    </style>

    <style name="Theme.CalculatorApp" parent="Base.Theme.CalculatorApp" />

    <style name="CalculatorNumberButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/calculator_number_key</item>
        <item name="cornerRadius">48dp</item>
        <item name="android:textColor">@color/calculator_text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="CalculatorFunctionButton" parent="CalculatorNumberButton">
        <item name="backgroundTint">@color/calculator_function_key</item>
        <item name="android:textColor">@color/calculator_text_primary</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="CalculatorOperatorButton" parent="CalculatorNumberButton">
        <item name="backgroundTint">@color/calculator_operator_key</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">24sp</item>
    </style>
</resources>